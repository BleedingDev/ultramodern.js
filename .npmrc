registry = 'https://registry.npmjs.org/'

# Fork note (UltraModern): the pnpm settings that used to live here
# (link-workspace-packages=false, strict-peer-dependencies=false) moved to
# pnpm-workspace.yaml because pnpm 11 no longer reads them from .npmrc.
# During that migration the fork also DELIBERATELY set
# `autoInstallPeers: false` there (upstream effective default: true) so that
# peer dependencies — notably `typescript` — are not auto-installed into
# packages that run the tsgo-first toolchain lane (cf. the
# peerDependencyRules.allowedVersions entry for
# '@module-federation/*>typescript' in pnpm-workspace.yaml).
# Do not flip autoInstallPeers back to true when reconciling upstream merges.
