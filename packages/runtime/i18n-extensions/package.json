{
  "name": "@modern-js/i18n-runtime-extensions",
  "description": "Fork-owned UltraModern.js i18n runtime coordination and localized-route extensions.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/bleedingdev/modern.js",
    "directory": "packages/runtime/i18n-extensions"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern.js",
    "i18n"
  ],
  "version": "3.8.3",
  "types": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest --passWithNoTests"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "dependencies": {
    "i18next-browser-languagedetector": "^8.2.1"
  },
  "peerDependencies": {
    "@modern-js/runtime": "workspace:^3.8.3",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
