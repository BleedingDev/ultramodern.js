{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "isolatedModules": true,
    "skipLibCheck": false,
    "rootDir": "./src",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["src"]
}
