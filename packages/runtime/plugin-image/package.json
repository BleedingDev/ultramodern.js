{
  "name": "@modern-js/image",
  "version": "3.8.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build && pnpm -w tsgo:dts \"$PWD\"",
    "dev": "rslib build --watch"
  },
  "dependencies": {
    "@rsbuild-image/core": "0.0.1-next.36",
    "@rsbuild-image/react": "0.0.1-next.36",
    "ipx": "^3.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@rslib/core": "0.23.2",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
