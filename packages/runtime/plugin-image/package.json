{
  "name": "@modern-js/image",
  "version": "3.9.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch"
  },
  "dependencies": {
    "@rsbuild-image/core": "0.0.1-next.36",
    "@rsbuild-image/react": "0.0.1-next.36",
    "ipx": "^4.0.0-beta.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@rslib/core": "1.0.3",
    "@types/node": "^26.6.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2"
  }
}
