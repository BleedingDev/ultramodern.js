{
  "name": "@modern-js/render",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/runtime/render"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.8.3",
  "files": [
    "dist",
    "hook.d.ts"
  ],
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build && pnpm -w tsgo:dts \"$PWD\"",
    "test": "tsgo --noEmit -p tsconfig.json && rstest --passWithNoTests"
  },
  "dependencies": {
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/build": "workspace:*",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-rspack": "0.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-rspack": "0.1.0"
  },
  "peerDependenciesMeta": {
    "react-server-dom-rspack": {
      "optional": true
    }
  },
  "exports": {
    "./ssr": {
      "types": "./dist/types/server/ssr/index.d.ts",
      "default": "./dist/esm/ssr.mjs"
    },
    "./rsc": {
      "types": "./dist/types/server/rsc/index.d.ts",
      "default": "./dist/esm/rsc.mjs"
    },
    "./rsc-worker": {
      "types": "./dist/types/rsc.worker.d.ts",
      "default": "./dist/esm/rscWorker.mjs"
    },
    "./client": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/esm/client.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "ssr": [
        "./dist/types/server/ssr/index.d.ts"
      ],
      "rsc": [
        "./dist/types/server/rsc/index.d.ts"
      ],
      "rsc-worker": [
        "./dist/types/rsc.worker.d.ts"
      ],
      "client": [
        "./dist/types/client/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/browser.d.ts"
  }
}
