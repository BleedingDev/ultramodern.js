{
  "name": "@modern-js/plugin-bff-extensions",
  "description": "Fork-owned UltraModern.js BFF adapters, generation, policy, and backend federation extensions.",
  "homepage": "https://github.com/BleedingDev/ultramodern.js#readme",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/cli/plugin-bff-extensions"
  },
  "license": "MIT",
  "keywords": [
    "bff",
    "effect",
    "framework",
    "modern.js",
    "ultramodern.js"
  ],
  "version": "3.8.3",
  "files": ["dist", "src"],
  "exports": {
    "./package.json": "./package.json",
    "./hono": {
      "types": "./dist/types/hono/index.d.ts",
      "modern:source": "./src/hono/index.ts",
      "node": {
        "import": "./dist/esm-node/hono/index.mjs",
        "require": "./dist/cjs/hono/index.js"
      },
      "import": "./dist/esm/hono/index.mjs",
      "default": "./dist/esm/hono/index.mjs"
    },
    "./cross-project-policy": {
      "types": "./dist/types/cross-project-policy/index.d.ts",
      "modern:source": "./src/cross-project-policy/index.ts",
      "node": {
        "import": "./dist/esm-node/cross-project-policy/index.mjs",
        "require": "./dist/cjs/cross-project-policy/index.js"
      },
      "default": "./dist/cjs/cross-project-policy/index.js"
    },
    "./cross-project-generation": {
      "types": "./dist/types/cross-project-generation/index.d.ts",
      "modern:source": "./src/cross-project-generation/index.ts",
      "node": {
        "import": "./dist/esm-node/cross-project-generation/index.mjs",
        "require": "./dist/cjs/cross-project-generation/index.js"
      },
      "default": "./dist/cjs/cross-project-generation/index.js"
    },
    "./effect-adapter": {
      "types": "./dist/types/effect-adapter/index.d.ts",
      "modern:source": "./src/effect-adapter/index.ts",
      "node": {
        "import": "./dist/esm-node/effect-adapter/index.mjs",
        "require": "./dist/cjs/effect-adapter/index.js"
      },
      "default": "./dist/cjs/effect-adapter/index.js"
    },
    "./effect-source-loader": {
      "types": "./dist/types/effect-source-loader/index.d.ts",
      "modern:source": "./src/effect-source-loader/index.ts",
      "node": {
        "import": "./dist/esm-node/effect-source-loader/index.mjs",
        "require": "./dist/cjs/effect-source-loader/index.js"
      },
      "default": "./dist/cjs/effect-source-loader/index.js"
    },
    "./client-generator": {
      "types": "./dist/types/client-generator/index.d.ts",
      "modern:source": "./src/client-generator/index.ts",
      "node": {
        "import": "./dist/esm-node/client-generator/index.mjs",
        "require": "./dist/cjs/client-generator/index.js"
      },
      "default": "./dist/cjs/client-generator/index.js"
    },
    "./backend-federation": {
      "types": "./dist/types/backend-federation/index.d.ts",
      "modern:source": "./src/backend-federation/index.ts",
      "node": {
        "import": "./dist/esm-node/backend-federation/index.mjs",
        "require": "./dist/cjs/backend-federation/index.js"
      },
      "import": "./dist/esm/backend-federation/index.mjs",
      "default": "./dist/esm/backend-federation/index.mjs"
    },
    "./backend-federation/edge": {
      "types": "./dist/types/backend-federation/edge.d.ts",
      "modern:source": "./src/backend-federation/edge.ts",
      "node": {
        "import": "./dist/esm-node/backend-federation/edge.mjs",
        "require": "./dist/cjs/backend-federation/edge.js"
      },
      "import": "./dist/esm/backend-federation/edge.mjs",
      "default": "./dist/esm/backend-federation/edge.mjs"
    },
    "./backend-federation/node": {
      "types": "./dist/types/backend-federation/node.d.ts",
      "modern:source": "./src/backend-federation/node.ts",
      "node": {
        "import": "./dist/esm-node/backend-federation/node.mjs",
        "require": "./dist/cjs/backend-federation/node.js"
      },
      "default": "./dist/cjs/backend-federation/node.js"
    },
    "./backend-federation-manifest": {
      "types": "./dist/types/backend-federation-manifest/index.d.ts",
      "modern:source": "./src/backend-federation-manifest/index.ts",
      "node": {
        "import": "./dist/esm-node/backend-federation-manifest/index.mjs",
        "require": "./dist/cjs/backend-federation-manifest/index.js"
      },
      "default": "./dist/cjs/backend-federation-manifest/index.js"
    },
    "./backend-federation-manifest/node": {
      "types": "./dist/types/backend-federation-manifest/node.d.ts",
      "modern:source": "./src/backend-federation-manifest/node.ts",
      "node": {
        "import": "./dist/esm-node/backend-federation-manifest/node.mjs",
        "require": "./dist/cjs/backend-federation-manifest/node.js"
      },
      "default": "./dist/cjs/backend-federation-manifest/node.js"
    }
  },
  "typesVersions": {
    "*": {
      "hono": ["./dist/types/hono/index.d.ts", "./src/hono/index.ts"],
      "cross-project-policy": [
        "./dist/types/cross-project-policy/index.d.ts",
        "./src/cross-project-policy/index.ts"
      ],
      "cross-project-generation": [
        "./dist/types/cross-project-generation/index.d.ts",
        "./src/cross-project-generation/index.ts"
      ],
      "effect-adapter": [
        "./dist/types/effect-adapter/index.d.ts",
        "./src/effect-adapter/index.ts"
      ],
      "effect-source-loader": [
        "./dist/types/effect-source-loader/index.d.ts",
        "./src/effect-source-loader/index.ts"
      ],
      "client-generator": [
        "./dist/types/client-generator/index.d.ts",
        "./src/client-generator/index.ts"
      ],
      "backend-federation": [
        "./dist/types/backend-federation/index.d.ts",
        "./src/backend-federation/index.ts"
      ],
      "backend-federation/edge": [
        "./dist/types/backend-federation/edge.d.ts",
        "./src/backend-federation/edge.ts"
      ],
      "backend-federation/node": [
        "./dist/types/backend-federation/node.d.ts",
        "./src/backend-federation/node.ts"
      ],
      "backend-federation-manifest": [
        "./dist/types/backend-federation-manifest/index.d.ts",
        "./src/backend-federation-manifest/index.ts"
      ],
      "backend-federation-manifest/node": [
        "./dist/types/backend-federation-manifest/node.d.ts",
        "./src/backend-federation-manifest/node.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "pretest": "pnpm run build",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "dependencies": {
    "@modern-js/bff-core": "workspace:*",
    "@modern-js/bff-effect": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-runtime-extensions": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@module-federation/runtime": "2.9.0",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect": "4.0.0-rc.112"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
