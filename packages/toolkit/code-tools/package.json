{
  "name": "@modern-js/code-tools",
  "description": "Code analysis tooling for Modern.js projects.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/code-tools"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js",
    "lint",
    "oxlint"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "version": "3.2.1",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/esm-node/index.js",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "oxlint-plugin": [
        "./dist/types/oxlint-plugin.d.ts"
      ],
      "microvertical-api-boundary": [
        "./dist/types/microvertical-api-boundary.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "modern:source": "./src/index.ts",
        "import": "./dist/esm-node/index.js",
        "require": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm-node/index.js"
    },
    "./strict-effect-runtime": {
      "types": "./dist/types/strict-effect-runtime.d.ts",
      "import": "./dist/esm-node/strict-effect-runtime.js",
      "require": "./dist/cjs/strict-effect-runtime.cjs"
    },
    "./oxlint-plugin": {
      "types": "./dist/types/oxlint-plugin.d.ts",
      "node": {
        "modern:source": "./src/oxlint-plugin.ts",
        "import": "./dist/esm-node/oxlint-plugin.js",
        "require": "./dist/cjs/oxlint-plugin.cjs"
      },
      "default": "./dist/esm-node/oxlint-plugin.js"
    },
    "./microvertical-api-boundary": {
      "types": "./dist/types/microvertical-api-boundary.d.ts",
      "import": "./dist/esm-node/microvertical-api-boundary.js",
      "require": "./dist/cjs/microvertical-api-boundary.cjs"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "rm -rf dist && rslib build -c rslib.config.mts",
    "dev": "rslib build -c rslib.config.mts -w",
    "test": "rstest --passWithNoTests"
  },
  "dependencies": {
    "oxlint": "1.81.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "resolve.exports": "2.0.3"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "1.0.0",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "main": "./dist/esm-node/index.js",
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "node": {
          "import": "./dist/esm-node/index.js",
          "require": "./dist/cjs/index.cjs"
        },
        "default": "./dist/esm-node/index.js"
      },
      "./strict-effect-runtime": {
        "types": "./dist/types/strict-effect-runtime.d.ts",
        "import": "./dist/esm-node/strict-effect-runtime.js",
        "require": "./dist/cjs/strict-effect-runtime.cjs"
      },
      "./oxlint-plugin": {
        "types": "./dist/types/oxlint-plugin.d.ts",
        "node": {
          "import": "./dist/esm-node/oxlint-plugin.js",
          "require": "./dist/cjs/oxlint-plugin.cjs"
        },
        "default": "./dist/esm-node/oxlint-plugin.js"
      },
      "./microvertical-api-boundary": {
        "types": "./dist/types/microvertical-api-boundary.d.ts",
        "import": "./dist/esm-node/microvertical-api-boundary.js",
        "require": "./dist/cjs/microvertical-api-boundary.cjs"
      }
    }
  },
  "modern:source": "./src/index.ts",
  "bin": {
    "modern-api-check": "./bin/modern-api-check.mjs",
    "modern-api-check-files": "./bin/modern-api-check-files.mjs"
  }
}
