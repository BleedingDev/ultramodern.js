{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "jsx": "preserve",
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "paths": {},
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
