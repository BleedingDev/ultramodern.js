{
  "name": "@modern-js/ultramodern-sandpack-profile",
  "description": "Fork-owned executable Sandpack profile for UltraModern.js applications.",
  "homepage": "https://bleedingdev.github.io/ultramodern.js/",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/toolkit/ultramodern-sandpack-profile"
  },
  "license": "MIT",
  "version": "3.8.3",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/esm/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:build-smoke": "node --experimental-strip-types --test tests/*.smoke.ts"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.23.2",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
