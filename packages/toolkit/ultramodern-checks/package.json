{
  "name": "@modern-js/ultramodern-checks",
  "description": "UltraModern.js generated project guardrails.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/ultramodern-checks"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js",
    "ultramodern"
  ],
  "type": "module",
  "version": "3.2.1",
  "types": "./src/index.ts",
  "main": "./dist/cjs/index.cjs",
  "bin": {
    "ultramodern-i18n-check": "./bin/ultramodern-i18n-check.js",
    "ultramodern-workspace-source-check": "./bin/ultramodern-workspace-source-check.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "modern:source": "./src/index.ts",
        "import": "./dist/esm-node/index.js",
        "require": "./dist/cjs/index.cjs"
      },
      "default": "./dist/cjs/index.cjs"
    },
    "./oxlint-plugin": {
      "types": "./dist/types/oxlint-plugin.d.ts",
      "node": {
        "modern:source": "./src/oxlint-plugin.ts",
        "import": "./dist/esm-node/oxlint-plugin.js",
        "require": "./dist/cjs/oxlint-plugin.cjs"
      },
      "default": "./dist/cjs/oxlint-plugin.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build && pnpm -w tsgo:dts \"$PWD\"",
    "test": "rstest --passWithNoTests"
  },
  "dependencies": {
    "oxlint": "1.68.0"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.21.5",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260606.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "node": {
          "import": "./dist/esm-node/index.js",
          "require": "./dist/cjs/index.cjs"
        },
        "default": "./dist/cjs/index.cjs"
      },
      "./oxlint-plugin": {
        "types": "./dist/types/oxlint-plugin.d.ts",
        "node": {
          "import": "./dist/esm-node/oxlint-plugin.js",
          "require": "./dist/cjs/oxlint-plugin.cjs"
        },
        "default": "./dist/cjs/oxlint-plugin.cjs"
      }
    }
  }
}
