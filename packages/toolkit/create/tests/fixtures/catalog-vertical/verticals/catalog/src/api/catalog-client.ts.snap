import { Effect, makeEffectHttpApiClient } from '@modern-js/plugin-bff/effect-client';
import type {
  HttpClientError,
  HttpApi,
  HttpApiClient,
  HttpApiGroup,
  Schema,
} from '@modern-js/plugin-bff/effect-client';
import { catalogApiContract, catalogApi, catalogOperationContexts } from '../../shared/api';
import type {
  CatalogCreateResponse,
  CatalogItem,
  CatalogListResponse,
  CatalogNotFound,
  OperationContext,
  CatalogReadiness,
} from '../../shared/api';

export { Effect, runEffectRequest } from '@modern-js/plugin-bff/effect-client';

type CatalogApiGroups =
  typeof catalogApi extends HttpApi.HttpApi<infer _ApiId, infer Groups> ? Groups : never;

export type CatalogClient = HttpApiClient.Client<
  Extract<CatalogApiGroups, HttpApiGroup.Constraint>,
  never,
  never
>;

export type CatalogClientError =
  | CatalogNotFound
  | HttpClientError.HttpClientError
  | Schema.SchemaError;

export type CatalogClientEffect<Success> = Effect.Effect<Success, CatalogClientError, never>;

export interface CatalogClientOptions {
  baseUrl?: string | URL;
  locale?: string;
  operationContext?: OperationContext;
  traceparent?: string;
}

export const createCatalogClient = (
  options: CatalogClientOptions = {},
): CatalogClientEffect<CatalogClient> =>
  makeEffectHttpApiClient(catalogApi, {
    baseUrl: options.baseUrl ?? catalogApiContract.apiPrefix,
    requestContext: {
      ...(options.locale === undefined ? {} : { locale: options.locale }),
      ...(options.operationContext === undefined
        ? {}
        : { operationContext: options.operationContext }),
      ...(options.traceparent === undefined ? {} : { traceparent: options.traceparent }),
    },
  });

export const listCatalog = (
  options: CatalogClientOptions & { limit?: number } = {},
): CatalogClientEffect<CatalogListResponse> =>
  createCatalogClient({
    ...options,
    operationContext: options.operationContext ?? catalogOperationContexts.list,
  }).pipe(Effect.flatMap((client) => client.catalog.list({ query: { limit: options.limit } })));

export const getCatalogReadiness = (
  options: CatalogClientOptions = {},
): CatalogClientEffect<CatalogReadiness> =>
  createCatalogClient({
    ...options,
    operationContext: options.operationContext ?? catalogOperationContexts.readiness,
  }).pipe(Effect.flatMap((client) => client.catalog.readiness({})));

export const getCatalog = (
  id: string,
  options: CatalogClientOptions = {},
): CatalogClientEffect<CatalogItem> =>
  createCatalogClient({
    ...options,
    operationContext: options.operationContext ?? catalogOperationContexts.get,
  }).pipe(Effect.flatMap((client) => client.catalog.get({ params: { id } })));

export const createCatalog = (
  title: string,
  options: CatalogClientOptions = {},
): CatalogClientEffect<CatalogCreateResponse> =>
  createCatalogClient({
    ...options,
    operationContext: options.operationContext ?? catalogOperationContexts.create,
  }).pipe(Effect.flatMap((client) => client.catalog.create({ payload: { title } })));
