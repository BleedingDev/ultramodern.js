import {
  HttpApi,
  HttpApiEndpoint,
  HttpApiGroup,
  HttpApiSchema,
  Schema,
} from '@modern-js/plugin-bff/effect-client';

export interface CatalogMarker {
  readonly appId: string;
  readonly build: string;
  readonly buildMarker: string;
  readonly deployProfile: string;
  readonly packageName: string;
  readonly sourceRevision: string;
  readonly surface: string;
  readonly unitId: string;
  readonly version: string;
}

export interface CatalogItem {
  readonly id: string;
  readonly marker: CatalogMarker;
  readonly title: string;
}

export interface CatalogReadiness {
  readonly checks: {
    readonly api: 'ready';
    readonly moduleFederation: 'ready';
    readonly ssr: 'ready';
    readonly translations: 'ready';
  };
  readonly marker: CatalogMarker;
  readonly status: 'ready';
  readonly versionSkew: 'none';
}

export interface CatalogCreatePayload {
  readonly title: string;
}

export interface CatalogListResponse {
  readonly items: readonly CatalogItem[];
}

export interface CatalogCreateResponse {
  readonly item: CatalogItem;
}

export interface CatalogNotFound {
  readonly _tag: 'CatalogNotFound';
  readonly id: string;
}

export const catalogMarkerSchema: Schema.Codec<CatalogMarker> = Schema.Struct({
  appId: Schema.String,
  build: Schema.String,
  buildMarker: Schema.String,
  deployProfile: Schema.String,
  packageName: Schema.String,
  sourceRevision: Schema.String,
  surface: Schema.String,
  unitId: Schema.String,
  version: Schema.String,
});

export const catalogItemSchema: Schema.Codec<CatalogItem> = Schema.Struct({
  id: Schema.String,
  marker: catalogMarkerSchema,
  title: Schema.String,
});

export const catalogReadinessSchema: Schema.Codec<CatalogReadiness> = Schema.Struct({
  checks: Schema.Struct({
    api: Schema.Literal('ready'),
    moduleFederation: Schema.Literal('ready'),
    ssr: Schema.Literal('ready'),
    translations: Schema.Literal('ready'),
  }),
  marker: catalogMarkerSchema,
  status: Schema.Literal('ready'),
  versionSkew: Schema.Literal('none'),
});

export const catalogCreatePayloadSchema: Schema.Codec<CatalogCreatePayload> = Schema.Struct({
  title: Schema.String,
});

export const catalogNotFoundSchema: Schema.Codec<CatalogNotFound> = Schema.TaggedStruct(
  'CatalogNotFound',
  {
    id: Schema.String,
  },
).pipe(HttpApiSchema.status(404));

export interface OperationContext {
  method: string;
  operationId: string;
  routePath: string;
  source: 'client' | 'server' | 'generated-client' | 'effect-adapter' | 'data-platform' | 'unknown';
  traceId?: string;
}

export const catalogApi = HttpApi.make('CatalogApi').add(
  HttpApiGroup.make('catalog')
    .add(
      HttpApiEndpoint.get('list', '/catalog', {
        query: {
          limit: Schema.optional(Schema.FiniteFromString),
        },
        success: Schema.Struct({
          items: Schema.Array(catalogItemSchema),
        }),
      }),
    )
    .add(
      HttpApiEndpoint.get('readiness', '/catalog/readiness', {
        success: catalogReadinessSchema,
      }),
    )
    .add(
      HttpApiEndpoint.get('get', '/catalog/:id', {
        error: catalogNotFoundSchema,
        params: {
          id: Schema.String,
        },
        success: catalogItemSchema,
      }),
    )
    .add(
      HttpApiEndpoint.post('create', '/catalog', {
        payload: catalogCreatePayloadSchema,
        success: Schema.Struct({
          item: catalogItemSchema,
        }),
      }),
    ),
);

export const catalogOperationContexts = {
  create: {
    method: 'POST',
    operationId: 'CatalogApi:catalog:create',
    routePath: '/catalog',
    source: 'generated-client',
  },
  get: {
    method: 'GET',
    operationId: 'CatalogApi:catalog:get',
    routePath: '/catalog/:id',
    source: 'generated-client',
  },
  list: {
    method: 'GET',
    operationId: 'CatalogApi:catalog:list',
    routePath: '/catalog',
    source: 'generated-client',
  },
  readiness: {
    method: 'GET',
    operationId: 'CatalogApi:catalog:readiness',
    routePath: '/catalog/readiness',
    source: 'generated-client',
  },
} satisfies Record<string, OperationContext>;

export const catalogApiContract = {
  apiPrefix: '/catalog-api',
  basePath: '/catalog-api/catalog',
  ownerId: 'catalog',
  readinessPath: '/catalog-api/catalog/readiness',
} as const;
