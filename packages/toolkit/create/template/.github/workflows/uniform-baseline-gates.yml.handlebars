name: Uniform Baseline Gates

on:
  push:
  pull_request:

jobs:
  baseline-gates:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: pnpm

      - name: Install Dependencies
        run: pnpm install

      - name: Validate Baseline Contract
        run: pnpm run baseline:check

      - name: Build
        run: pnpm run build

