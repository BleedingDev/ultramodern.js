interface RemoteComponentModule {
  default: ComponentType;
}

const RemoteUnavailable = () => {
  const { t } = useModernI18n();
  return <div className="{{value1}}">{t('shell.remoteUnavailable')}</div>;
};

// A Cloudflare Worker cannot execute a Module Federation remote at SSR time
// (Workers forbid dynamic remote-code evaluation and MF 2.7.0 has no edge
// runtime), so remote widgets mount client-only via the framework NoSSR
// primitive: the shell SSRs a typed placeholder and the browser MF runtime loads
// the native createLazyComponent remote after hydration. Rendering the remote
// fresh post-mount avoids the "moduleId is empty" MF hydration failure. True
// remote SSR requires distributed SSR over service bindings — see ADR-0021.
const createRemoteComponent = (
  loader: () => Promise<RemoteComponentModule>,
): ComponentType => {
  const RemoteWidget = createLazyComponent({
    export: 'default',
    fallback: <RemoteUnavailable />,
    instance: getInstance(),
    loader,
    loading: null,
  });

  return function ClientRemoteComponent() {
    return (
      <NoSSR fallback={<RemoteUnavailable />}>
        <RemoteWidget />
      </NoSSR>
    );
  };
};
