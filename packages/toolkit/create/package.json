{
  "name": "@modern-js/create",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/create"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "version": "3.2.1",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/esm-node/index.js",
  "bin": {
    "create": "./bin/run.js",
    "modern-js-create": "./bin/run.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "modern:source": "./src/index.ts",
        "import": "./dist/esm-node/index.js",
        "require": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm-node/index.js"
    }
  },
  "files": [
    "template-workspace",
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "rm -rf dist && rslib build -c rslibconfig.mts && pnpm -w tsgo:dts \"$PWD\"",
    "dev": "rslib build -c rslibconfig.mts -w",
    "start": "node ./dist/esm-node/index.js",
    "test": "rm -rf dist && rslib build -c rslibconfig.mts && rstest --passWithNoTests"
  },
  "dependencies": {
    "@modern-js/i18n-utils": "workspace:*"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.21.5",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260606.1",
    "tsx": "^4.22.3"
  },
  "publishConfig": {
    "main": "./dist/esm-node/index.js",
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "node": {
          "import": "./dist/esm-node/index.js",
          "require": "./dist/cjs/index.cjs"
        },
        "default": "./dist/esm-node/index.js"
      }
    }
  },
  "modern:source": "./src/index.ts"
}
