      );
    }
    for (const section of [
      'dependencies',
      'devDependencies',
      'optionalDependencies',
      'peerDependencies',
    ]) {
      for (const packageName of modernPackageNames) {
        const actual = packageJson[section]?.[packageName];
        if (actual !== undefined) {
