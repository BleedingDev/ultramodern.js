{{federationImports}}import { Link, useModernI18n } from '@modern-js/plugin-i18n/runtime';

	const widgetCount = Number('{{widgetCount}}');

	{{federationHelpers}}
	{{remoteComponentExports}}

	export const Header = () => {
  const { t } = useModernI18n();

  return (
    <header className="{{headerClassName}}" data-modern-boundary-id="{{boundaryId}}" data-modern-mf-expose="shell/Header">
      <Link className="{{titleClassName}}" to="/">{t('shell.title')}</Link>
    </header>
  );
};

export const StatusBadge = () => {
  const { t } = useModernI18n();

  return (
    <span className="{{statusBadgeClassName}}">
      {widgetCount} {t('shell.hero.cardOneKicker')}
    </span>
  );
};

export const VerticalShowcase = () => {
  const { t } = useModernI18n();

  if (widgetCount === 0) {
    return (
      <section className="{{emptyShowcaseClassName}}">
        <p className="{{emptyMessageClassName}}">{t('shell.hero.empty')}</p>
      </section>
    );
  }

  return (
    <section className="{{showcaseClassName}}" data-modern-boundary-id="{{boundaryId}}">
      {{showcaseGrid}}
    </section>
  );
};
