interface RemoteComponentModule {
  default: ComponentType;
}

const RemoteUnavailable = () => {
  const { t } = useModernI18n();
  return <div className="{{value1}}">{t('shell.remoteUnavailable')}</div>;
};

const createRemoteComponent = (
  remote: string,
  expose: string,
  loader: () => Promise<RemoteComponentModule>,
) =>
  createDistributedSsrComponent({
    createComponent: () =>
      createLazyComponent({
        export: 'default',
        fallback: <RemoteUnavailable />,
        instance: getInstance(),
        loader,
        loading: null,
      }),
    expose,
    fallback: <RemoteUnavailable />,
    remote,
  });
