interface RemoteComponentModule {
  default: FunctionComponent;
}

const RemoteUnavailable = () => {
  const { t } = useModernI18n();
  return <div className="{{unavailableClassName}}">{t('shell.remoteUnavailable')}</div>;
};

const createRemoteComponent = (
  remote: string,
  expose: string,
  moduleId: string,
) =>
  createDistributedSsrComponent({
    createComponent: options =>
      createLazyComponent({
        ...options,
        instance: getInstance(),
        loader: () => loadRemote<RemoteComponentModule>(moduleId) as Promise<RemoteComponentModule>,
      }),
    expose,
    fallback: <RemoteUnavailable />,
    remote,
  });
