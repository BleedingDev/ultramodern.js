const RemoteUnavailable = () => {
  const { t } = useModernI18n();
  return <div className="{{unavailableClassName}}">{t('shell.remoteUnavailable')}</div>;
};

const createRemoteComponent = (remote: string, expose: string) =>
  function WorkerRemoteComponent() {
    return (
      <DistributedSsrBoundary
        expose={expose}
        fallback={<RemoteUnavailable />}
        remote={remote}
      >
        {null}
      </DistributedSsrBoundary>
    );
  };
