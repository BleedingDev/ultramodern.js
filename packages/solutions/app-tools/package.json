{
  "name": "@modern-js/app-tools",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/solutions/app-tools"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.8.1",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./builder": {
      "types": "./dist/types/builder/index.d.ts",
      "node": {
        "import": "./dist/esm-node/builder/index.mjs",
        "require": "./dist/cjs/builder/index.js"
      },
      "default": "./dist/cjs/builder/index.js"
    },
    "./config": {
      "types": "./dist/types/config/public.d.ts",
      "import": "./dist/esm-node/config/public.mjs",
      "require": "./dist/cjs/config/public.js",
      "default": "./dist/cjs/config/public.js"
    },
    "./cli": {
      "types": "./dist/types/index.d.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./cli/run": {
      "types": "./dist/types/run/index.d.ts",
      "node": {
        "import": "./dist/esm-node/run/index.mjs",
        "require": "./dist/cjs/run/index.js"
      },
      "default": "./dist/cjs/run/index.js"
    },
    "./cloudflare-output-verifier": {
      "types": "./dist/types/plugins/deploy/platforms/cloudflare-output-verifier/index.d.ts",
      "import": "./dist/esm-node/plugins/deploy/platforms/cloudflare-output-verifier/index.mjs",
      "require": "./dist/cjs/plugins/deploy/platforms/cloudflare-output-verifier/index.js",
      "default": "./dist/cjs/plugins/deploy/platforms/cloudflare-output-verifier/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.d.ts"
    },
    "./bundle-docs": {
      "types": "./dist/types/bundleDocs.d.ts",
      "default": "./dist/esm-node/bundleDocs.mjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts"
      ],
      "cli/run": [
        "./dist/types/run/index.d.ts"
      ],
      "types": [
        "./lib/types.d.ts"
      ],
      "builder": [
        "./dist/types/builder/index.d.ts"
      ],
      "config": [
        "./dist/types/config/public.d.ts"
      ],
      "bundle-docs": [
        "./dist/types/bundleDocs.d.ts"
      ]
    }
  },
  "bin": {
    "modern": "./bin/modern.js",
    "modern-app": "./bin/modern.js",
    "modern-bundle-docs": "./bin/modern-bundle-docs.js"
  },
  "nx": {
    "targets": {
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@modern-js/main-doc"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "build",
          "^build",
          "{workspaceRoot}/packages/document/doc_build/**/*.md",
          "{workspaceRoot}/packages/document/doc_build/llms.txt"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/docs"
        ]
      }
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build && pnpm -w tsgo:dts \"$PWD\" && pnpm run verify:public-surface && node ./bin/modern-bundle-docs.js",
    "verify:public-surface": "node ./tests/config/verify-public-surface.mjs",
    "test": "rstest"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@loadable/component": "5.16.7",
    "@modern-js/builder": "workspace:*",
    "@modern-js/i18n-utils": "workspace:*",
    "@modern-js/plugin": "workspace:*",
    "@modern-js/plugin-data-loader": "workspace:*",
    "@modern-js/prod-server": "workspace:*",
    "@modern-js/server": "workspace:*",
    "@modern-js/server-core": "workspace:*",
    "@modern-js/server-utils": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@rsbuild/core": "2.1.5",
    "@swc/core": "1.15.43",
    "@swc/helpers": "^0.5.23",
    "compression-webpack-plugin": "^12.0.0",
    "es-module-lexer": "^2.3.0",
    "esbuild": "^0.28.1",
    "flatted": "^3.4.2",
    "import-meta-resolve": "^4.2.0",
    "mlly": "^1.8.2",
    "ndepe": "^0.1.13",
    "pkg-types": "^2.3.1",
    "std-env": "4.2.0"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/rstest-config": "workspace:*",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "tsconfig-paths": {
      "optional": true
    },
    "ts-node": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
