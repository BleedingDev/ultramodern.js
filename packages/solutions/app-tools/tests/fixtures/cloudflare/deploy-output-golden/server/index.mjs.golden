    const location = response.headers.get('location');

    if (location) {
      const nextUrl = new URL(location, request.url);
      const currentUrl = new URL(request.url);

      if (nextUrl.origin === currentUrl.origin) {
        return fetchAssetByPathFollowingRedirects(
          nextUrl.pathname,
          request,
          env,
          visited,
