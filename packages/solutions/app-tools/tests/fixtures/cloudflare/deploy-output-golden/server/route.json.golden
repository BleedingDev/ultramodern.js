{
  "routes": [
    {
      "urlPath": "/",
      "entryName": "main",
      "entryPath": "html/main/index.html",
      "isSSR": true,
      "worker": "worker/main.js",
      "bundle": "bundles/main.js"
    },
    {
      "urlPath": "/plain",
      "entryName": "plain",
      "entryPath": "html/plain/index.html",
      "isSSR": false
    }
  ]
}
