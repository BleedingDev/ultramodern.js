{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modern-cloudflare-output-golden",
  "compatibility_date": "2026-06-02",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FEATURE_FLAG": "golden"
  },
  "main": "server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
