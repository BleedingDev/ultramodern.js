{
  "name": "@modern-js/bff-effect",
  "description": "Fork-owned Effect runtime, client, edge dispatcher, and data-platform primitives for UltraModern.js BFFs.",
  "homepage": "https://github.com/BleedingDev/ultramodern.js#readme",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/server/bff-effect"
  },
  "license": "MIT",
  "keywords": [
    "effect",
    "bff",
    "framework",
    "modern.js",
    "ultramodern.js"
  ],
  "version": "3.8.3",
  "files": ["dist", "src"],
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./effect": {
      "types": "./dist/types/effect/index.d.ts",
      "modern:source": "./src/effect/index.ts",
      "node": {
        "import": "./dist/esm-node/effect/index.mjs",
        "require": "./dist/cjs/effect/index.js"
      },
      "default": "./dist/cjs/effect/index.js"
    },
    "./effect-edge": {
      "types": "./dist/types/effect/edge.d.ts",
      "modern:source": "./src/effect/edge.ts",
      "node": {
        "import": "./dist/esm-node/effect/edge.mjs",
        "require": "./dist/cjs/effect/edge.js"
      },
      "import": "./dist/esm/effect/edge.mjs",
      "default": "./dist/esm/effect/edge.mjs"
    },
    "./effect-client": {
      "types": "./dist/types/effect-client/index.d.ts",
      "modern:source": "./src/effect-client/index.ts",
      "node": {
        "import": "./dist/esm-node/effect-client/index.mjs",
        "require": "./dist/cjs/effect-client/index.js"
      },
      "import": "./dist/esm/effect-client/index.mjs",
      "default": "./dist/esm/effect-client/index.mjs"
    },
    "./effect-client-runtime": {
      "types": "./dist/types/effect-client/runtime.d.ts",
      "modern:source": "./src/effect-client/runtime.ts",
      "node": {
        "import": "./dist/esm-node/effect-client/runtime.mjs",
        "require": "./dist/cjs/effect-client/runtime.js"
      },
      "import": "./dist/esm/effect-client/runtime.mjs",
      "default": "./dist/esm/effect-client/runtime.mjs"
    },
    "./data-platform": {
      "types": "./dist/types/data-platform/index.d.ts",
      "modern:source": "./src/data-platform/index.ts",
      "node": {
        "import": "./dist/esm-node/data-platform/index.mjs",
        "require": "./dist/cjs/data-platform/index.js"
      },
      "import": "./dist/esm/data-platform/index.mjs",
      "default": "./dist/esm/data-platform/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": ["./dist/types/index.d.ts", "./src/index.ts"],
      "effect": ["./dist/types/effect/index.d.ts", "./src/effect/index.ts"],
      "effect-edge": ["./dist/types/effect/edge.d.ts", "./src/effect/edge.ts"],
      "effect-client": [
        "./dist/types/effect-client/index.d.ts",
        "./src/effect-client/index.ts"
      ],
      "effect-client-runtime": [
        "./dist/types/effect-client/runtime.d.ts",
        "./src/effect-client/runtime.ts"
      ],
      "data-platform": [
        "./dist/types/data-platform/index.d.ts",
        "./src/data-platform/index.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "dependencies": {
    "@modern-js/bff-core": "workspace:*",
    "@modern-js/create-request": "workspace:*",
    "@modern-js/runtime-extensions": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/sdk-trace-web": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "peerDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/opentelemetry": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect": "4.0.0-rc.112"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
