{
  "name": "@modern-js/bff-core",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/server/bff-core"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "version": "3.8.3",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/cjs/index.js"
    },
    "./security/cross-project-policy": {
      "types": "./dist/types/security/crossProjectPolicy.d.ts",
      "modern:source": "./src/security/crossProjectPolicy.ts",
      "node": {
        "import": "./dist/esm-node/security/crossProjectPolicy.mjs",
        "require": "./dist/cjs/security/crossProjectPolicy.js"
      },
      "default": "./dist/esm/security/crossProjectPolicy.mjs"
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest --passWithNoTests"
  },
  "dependencies": {
    "@modern-js/utils": "workspace:*",
    "@swc/helpers": "^0.5.23",
    "koa-compose": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "type-fest": "5.8.0"
  },
  "devDependencies": {
    "@modern-js/bff-runtime": "workspace:*",
    "@modern-js/rslib": "workspace:*",
    "@modern-js/types": "workspace:*",
    "@rslib/core": "0.23.2",
    "@scripts/rstest-config": "workspace:*",
    "@types/koa-compose": "^3.2.9",
    "@types/node": "^26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "^0.28.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
