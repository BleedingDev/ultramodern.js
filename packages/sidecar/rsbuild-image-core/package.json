{
  "name": "@bleedingdev/rsbuild-image-core",
  "version": "0.1.0",
  "description": "UltraModern sidecar repackage of @rsbuild-image/core@0.0.1-next.36 with its image-size dependency aliased to the hardened @bleedingdev/image-size fork",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "type": "commonjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Rspack Contrib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BleedingDev/ultramodern.js.git",
    "directory": "packages/sidecar/rsbuild-image-core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "module": "./dist/index.mjs"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "node": "./dist/loader.js",
      "module": "./dist/loader.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "node": "./dist/shared/index.js",
      "module": "./dist/shared/index.mjs"
    },
    "./image-loader": {
      "types": "./dist/shared/image-loader.d.ts",
      "node": "./dist/shared/image-loader.mjs",
      "module": "./dist/shared/image-loader.mjs"
    },
    "./types": {
      "types": "./dist/env.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "loader": [
        "./dist/loader.d.ts"
      ],
      "shared": [
        "./dist/shared/index.d.ts"
      ],
      "image-loader": [
        "./dist/shared/image-loader.d.ts"
      ],
      "types": [
        "./dist/env.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css",
    "dist/logger.*"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "verify": "node scripts/verify-manifest.mjs"
  },
  "dependencies": {
    "image-size": "npm:@bleedingdev/image-size@2.1.0",
    "knitwork": "^1.2.0",
    "rslog": "^1.1.0",
    "type-fest": "^4.37.0",
    "ufo": "^1.3.0"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0",
    "sharp": ">=0.33.5",
    "ipx": ">=3.0.3"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "ipx": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
