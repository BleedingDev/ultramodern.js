{
  "name": "@bleedingdev/ipx",
  "version": "3.2.0",
  "description": "UltraModern sidecar fork of ipx: high performance, secure and easy-to-use image optimizer, built against sharp ^0.35.3.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BleedingDev/ultramodern.js.git",
    "directory": "packages/sidecar/ipx"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": "./bin/ipx.mjs",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "verify:sharpen": "node ./scripts/verify-sharpen.mjs"
  },
  "dependencies": {
    "@fastify/accept-negotiator": "^2.0.1",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "destr": "^2.0.5",
    "etag": "^1.8.1",
    "h3": "^1.15.3",
    "image-meta": "^0.2.1",
    "listhen": "^1.9.0",
    "ofetch": "^1.4.1",
    "pathe": "^2.0.3",
    "sharp": "^0.35.3",
    "svgo": "^4.0.0",
    "ufo": "^1.6.1",
    "unstorage": "^1.16.1",
    "xss": "^1.0.15"
  }
}
