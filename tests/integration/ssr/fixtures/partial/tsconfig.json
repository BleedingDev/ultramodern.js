{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "baseUrl": "./",
    "rootDir": "../../../../",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@api/*": ["./api/*"]
    },
    "module": "Node16",
    "moduleResolution": "node16"
  },
  "include": ["src", "shared", "config", "modern.config.ts", "api", "server"]
}
