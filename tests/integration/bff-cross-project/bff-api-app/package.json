{
  "name": "bff-api-app",
  "version": "2.66.0",
  "scripts": {
    "dev": "modern dev",
    "dev:bff": "modern dev --api-only",
    "build": "modern build",
    "serve": "modern serve",
    "deploy": "modern deploy",
    "start:bff": "modern serve --api-only",
    "new": "modern new"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/plugin-bff": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/server-runtime": "workspace:*",
    "express": "^5.2.1",
    "effect": "4.0.0-rc.112",
    "hono": "^4.12.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./api/*": {
      "import": "./dist-1/client/*.js",
      "types": "./dist-1/client/*.d.ts"
    },
    "./plugin": {
      "import": "./dist-1/plugin/index.js",
      "require": "./dist-1/plugin/index.js",
      "types": "./dist-1/plugin/index.d.ts"
    },
    "./runtime": {
      "import": "./dist-1/runtime/index.js",
      "require": "./dist-1/runtime/index.js",
      "types": "./dist-1/runtime/index.d.ts"
    },
    "./api/context/index": {
      "import": "./dist-1/client/context/index.js",
      "types": "./dist-1/client/context/index.d.ts"
    },
    "./api/effect/index": {
      "import": "./dist-1/client/effect/index.js",
      "types": "./dist-1/client/effect/index.d.ts"
    },
    "./api/index": {
      "import": "./dist-1/client/index.js",
      "types": "./dist-1/client/index.d.ts"
    },
    "./api/portable": {
      "import": "./dist-1/client/portable.js",
      "types": "./dist-1/client/portable.d.ts"
    },
    "./api/upload": {
      "import": "./dist-1/client/upload.js",
      "types": "./dist-1/client/upload.d.ts"
    },
    "./api/user/[id]": {
      "import": "./dist-1/client/user/[id].js",
      "types": "./dist-1/client/user/[id].d.ts"
    },
    "./api/user/index": {
      "import": "./dist-1/client/user/index.js",
      "types": "./dist-1/client/user/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "api/*": [
        "./dist-1/client/*.d.ts"
      ],
      "runtime": [
        "./dist-1/runtime/index.d.ts"
      ],
      "plugin": [
        "./dist-1/plugin/index.d.ts"
      ],
      "api/context/index": [
        "./dist-1/client/context/index.d.ts"
      ],
      "api/effect/index": [
        "./dist-1/client/effect/index.d.ts"
      ],
      "api/index": [
        "./dist-1/client/index.d.ts"
      ],
      "api/portable": [
        "./dist-1/client/portable.d.ts"
      ],
      "api/upload": [
        "./dist-1/client/upload.d.ts"
      ],
      "api/user/[id]": [
        "./dist-1/client/user/[id].d.ts"
      ],
      "api/user/index": [
        "./dist-1/client/user/index.d.ts"
      ]
    }
  },
  "files": [
    "dist-1/client/**/*",
    "dist-1/runtime/**/*",
    "dist-1/plugin/**/*",
    "dist-1/**/*.d.ts"
  ]
}
