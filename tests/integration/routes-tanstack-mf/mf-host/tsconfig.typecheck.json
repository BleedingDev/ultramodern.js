{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@modern-js/plugin-tanstack/runtime": [
        "./src/type-tests/plugin-tanstack-runtime-shim.d.ts"
      ],
      "remote/*": ["./@mf-types/remote/*"],
      "remote2/*": ["./@mf-types/remote2/*"]
    }
  },
  "include": [
    "@mf-types/**/*.d.ts",
    "src/type-tests/api-shim.d.ts",
    "src/type-tests/plugin-tanstack-runtime-shim.d.ts",
    "src/routes/mf/remoteLoader.tsx",
    "src/routes/mf/remoteSsrFallback.ts",
    "src/routes/mf/page.tsx",
    "src/routes/mf/page.data.ts",
    "src/routes/mf-not-found/page.tsx",
    "src/routes/mf-not-found/page.data.ts",
    "src/routes/mf-redirect/page.tsx",
    "src/routes/mf-redirect/page.data.ts",
    "src/type-tests/module-federation.tsx"
  ]
}
