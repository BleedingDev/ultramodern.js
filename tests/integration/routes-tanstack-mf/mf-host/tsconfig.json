{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@api/*": ["./api/*"],
      "@shared/*": ["./shared/*"],
      "remote/*": ["./@mf-types/remote/*"],
      "remote2/*": ["./@mf-types/remote2/*"]
    }
  },
  "include": ["src", "api", "shared", "@mf-types/**/*.d.ts", "modern.config.ts"]
}
