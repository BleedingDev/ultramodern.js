{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@api/*": ["./api/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "api", "shared", "modern.config.ts"]
}
