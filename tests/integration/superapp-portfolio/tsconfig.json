{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@api/*": ["./api/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["api", "src", "shared", "modern.config.ts"]
}
