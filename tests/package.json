{
  "private": true,
  "name": "tests",
  "version": "2.66.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:rspack": "pnpm test:builder:rspack && pnpm test:framework",
    "test:framework": "vitest run -c vitest.framework.config.mjs",
    "test:framework:effect": "vitest run -c vitest.effect.config.mjs",
    "test:builder": "cd e2e/builder && pnpm test",
    "test:builder:rspack": "cd e2e/builder && pnpm test",
    "test:module-tools": "jest -c jest.module-tools.config.js",
    "test:superapp-contracts": "jest -c jest.superapp-contracts.config.js",
    "test": "pnpm test --filter api-service-koa & pnpm test:framework",
    "test:ut": "node --conditions=jsnext:source -r tsm ./node_modules/jest/bin/jest.js -c jest-ut.config.js --maxWorkers=2",
    "prepare": "node node_modules/puppeteer/install.js",
    "test:mwa": "ts-node -T generator/mwa.ts",
    "test:module": "ts-node -T generator/module.ts",
    "test:monorepo": "ts-node -T generator/monorepo.ts"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/plugin-polyfill": "workspace:*",
    "@modern-js/utils": "workspace:*",
