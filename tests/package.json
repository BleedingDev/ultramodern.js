{
  "private": true,
  "name": "tests",
  "version": "2.66.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:rspack": "pnpm test:builder:rspack && pnpm test:framework",
    "test:framework": "vitest run -c vitest.framework.config.mjs",
    "test:framework:serial": "VITEST_FRAMEWORK_PARALLEL=0 vitest run -c vitest.framework.config.mjs",
    "test:framework:effect": "vitest run -c vitest.effect.config.mjs",
    "test:framework:effect:serial": "VITEST_FRAMEWORK_PARALLEL=0 vitest run -c vitest.effect.config.mjs",
    "test:builder": "cd e2e/builder && pnpm test",
    "test:builder:rspack": "cd e2e/builder && pnpm test",
    "test:module-tools": "rstest run -c rstest.module-tools.config.ts --passWithNoTests",
    "test:superapp-contracts": "rstest run -c rstest.superapp-contracts.config.ts",
    "test": "pnpm test --filter api-service-koa & pnpm test:framework",
    "test:ut": "pnpm -w run test:ut",
    "prepare": "node -e \"import('puppeteer/install.mjs')\"",
    "test:mwa": "ts-node -T generator/mwa.ts",
    "test:module": "ts-node -T generator/module.ts",
    "test:monorepo": "ts-node -T generator/monorepo.ts"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/plugin-polyfill": "workspace:*",
    "@modern-js/utils": "workspace:*",
    "@swc/core": "1.15.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "cross-spawn": "^7.0.6",
    "enhanced-resolve": "5.19.0",
    "fs-extra": "^11.3.3",
    "get-port": "7.1.0",
    "kill-port": "^2.0.1",
    "puppeteer": "^24.37.5",
    "rimraf": "^6.1.3",
    "tree-kill": "^1.2.2",
    "ts-node": "^10.9.2",
    "tsm": "2.3.0",
    "typescript": "6.0.0-beta",
    "vitest": "^4.1.4"
  }
}
