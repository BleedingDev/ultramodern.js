    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "cross-spawn": "^7.0.6",
    "enhanced-resolve": "5.19.0",
    "fs-extra": "^11.3.3",
    "get-port": "7.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jest-puppeteer": "^11.0.0",
    "kill-port": "^2.0.1",
    "puppeteer": "^24.37.5",
    "rimraf": "^6.1.3",
    "tree-kill": "^1.2.2",
    "ts-node": "^10.9.2",
    "tsm": "2.3.0",
    "typescript": "^5.9.3"
  }
}
