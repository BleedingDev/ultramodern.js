{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modernjs.dev/super-app-rfc-adr/contracts/mv-ownership.schema.json",
  "title": "Micro Vertical Ownership And Blast Radius Contract",
  "description": "Schema for route, remote, service, and shared-package ownership metadata used by graph-aware extraction and release gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "principals",
    "ownershipTargets",
    "pathRules",
    "dependencyGraphImpact",
    "approvalGates",
    "extractionBoundaryChecks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "contractId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string"
    },
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/principal"
      },
      "uniqueItems": true
    },
    "ownershipTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "remotes", "services", "sharedPackages"],
      "properties": {
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/routeOwnership"
          }
        },
        "remotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/remoteOwnership"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceOwnership"
          }
        },
        "sharedPackages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sharedPackageOwnership"
          }
        }
      }
    },
    "pathRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathRule"
      }
    },
    "dependencyGraphImpact": {
      "$ref": "#/$defs/dependencyGraphImpact"
    },
    "approvalGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/approvalGate"
      }
    },
    "extractionBoundaryChecks": {
      "$ref": "#/$defs/extractionBoundaryChecks"
    },
    "gateInputs": {
      "$ref": "#/$defs/gateInputs"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    }
  },
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "displayName"],
      "properties": {
        "id": {
          "$ref": "#/$defs/principalId"
        },
        "type": {
          "type": "string",
          "enum": ["human", "team", "agent", "service-account"]
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "minLength": 1
        },
        "escalation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "principalId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:@/-]*$"
    },
    "principalRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/principalId"
      },
      "uniqueItems": true
    },
    "ownershipCommon": {
      "type": "object",
      "required": ["id", "vertical", "owners"],
      "properties": {
        "id": {
          "$ref": "#/$defs/targetId"
        },
        "vertical": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "owners": {
          "$ref": "#/$defs/principalRefs"
        },
        "approvers": {
          "$ref": "#/$defs/principalRefs"
        },
        "incidentOwners": {
          "$ref": "#/$defs/principalRefs"
        },
        "supportMatrixRef": {
          "type": "string",
          "minLength": 1
        },
        "runtimeLane": {
          "type": "string",
          "enum": [
            "effect-first",
            "tanstack-first",
            "module-federation",
            "hono-compatibility",
            "shared-package"
          ]
        }
      }
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._:/@-]*$"
    },
    "routeOwnership": {
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/ownershipCommon"
        },
        {
          "type": "object",
          "required": ["routePatterns"],
          "properties": {
            "routePatterns": {
              "$ref": "#/$defs/stringList"
            },
            "loaderContractRefs": {
              "$ref": "#/$defs/stringList"
            },
            "remoteContractRefs": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ]
    },
    "remoteOwnership": {
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/ownershipCommon"
        },
        {
          "type": "object",
          "required": ["remoteNames"],
          "properties": {
            "remoteNames": {
              "$ref": "#/$defs/stringList"
            },
            "trustPolicyRefs": {
              "$ref": "#/$defs/stringList"
            },
            "compatibilityDigestRefs": {
              "$ref": "#/$defs/stringList"
            },
            "fallbackRefs": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ]
    },
    "serviceOwnership": {
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/ownershipCommon"
        },
        {
          "type": "object",
          "required": ["serviceIds", "apiContractRefs"],
          "properties": {
            "serviceIds": {
              "$ref": "#/$defs/stringList"
            },
            "apiContractRefs": {
              "$ref": "#/$defs/stringList"
            },
            "authBoundaryRefs": {
              "$ref": "#/$defs/stringList"
            },
            "sessionBoundaryRefs": {
              "$ref": "#/$defs/stringList"
            },
            "traceBoundaryRefs": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ]
    },
    "sharedPackageOwnership": {
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/ownershipCommon"
        },
        {
          "type": "object",
          "required": ["packageNames", "publicApiRefs"],
          "properties": {
            "packageNames": {
              "$ref": "#/$defs/stringList"
            },
            "publicApiRefs": {
              "$ref": "#/$defs/stringList"
            },
            "allowedConsumerVerticals": {
              "$ref": "#/$defs/stringList"
            },
            "forbiddenConsumerVerticals": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      ]
    },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetId", "includeGlobs", "rule"],
      "properties": {
        "id": {
          "$ref": "#/$defs/targetId"
        },
        "targetId": {
          "$ref": "#/$defs/targetId"
        },
        "includeGlobs": {
          "$ref": "#/$defs/stringList"
        },
        "excludeGlobs": {
          "$ref": "#/$defs/stringList"
        },
        "rule": {
          "type": "string",
          "enum": ["owned", "shared-readonly", "shared-api-only", "forbidden"]
        },
        "requiresApprovalGateIds": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "dependencyGraphImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphSources", "impactRules", "requiredOutputs"],
      "properties": {
        "graphSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "path"],
            "properties": {
              "id": {
                "$ref": "#/$defs/targetId"
              },
              "type": {
                "type": "string",
                "enum": [
                  "import-graph",
                  "route-graph",
                  "remote-graph",
                  "service-contract-graph",
                  "package-consumer-graph",
                  "incident-graph",
                  "support-matrix"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "impactRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "then"],
            "properties": {
              "id": {
                "$ref": "#/$defs/targetId"
              },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targetKinds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["route", "remote", "service", "shared-package"]
                    },
                    "uniqueItems": true
                  },
                  "changedPathMatches": {
                    "$ref": "#/$defs/stringList"
                  },
                  "crossesVertical": {
                    "type": "boolean"
                  },
                  "graphDepthGreaterThan": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "riskTier": {
                    "$ref": "#/$defs/riskTier"
                  },
                  "requireApprovalGateIds": {
                    "$ref": "#/$defs/stringList"
                  },
                  "requireEvidence": {
                    "$ref": "#/$defs/stringList"
                  },
                  "blockIfCircularDependency": {
                    "type": "boolean"
                  },
                  "blockIfUnownedConsumer": {
                    "type": "boolean"
                  },
                  "maxAllowedGraphDepth": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "changed-targets",
              "direct-consumers",
              "transitive-consumers",
              "cross-vertical-consumers",
              "support-matrix-rows",
              "incident-hooks",
              "approval-plan"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "approvalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "requiredApprovals"],
      "properties": {
        "id": {
          "$ref": "#/$defs/targetId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "appliesWhen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "riskTiers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/riskTier"
              },
              "uniqueItems": true
            },
            "crossesVertical": {
              "type": "boolean"
            },
            "targetKinds": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["route", "remote", "service", "shared-package"]
              },
              "uniqueItems": true
            },
            "requiresIncidentReview": {
              "type": "boolean"
            },
            "requiresSupportMatrixReview": {
              "type": "boolean"
            }
          }
        },
        "requiredApprovals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumCount", "principalTypes"],
          "properties": {
            "minimumCount": {
              "type": "integer",
              "minimum": 1
            },
            "principalTypes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["human", "team", "agent", "service-account"]
              },
              "uniqueItems": true
            },
            "mustIncludeOwningVertical": {
              "type": "boolean"
            },
            "mustIncludeImpactedVerticals": {
              "type": "boolean"
            },
            "mustIncludePlatformOwner": {
              "type": "boolean"
            }
          }
        },
        "evidenceRefs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "extractionBoundaryChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noCrossVerticalImports",
        "allowedCrossingModes",
        "requiredBoundaryRefs",
        "remoteExtractionReadiness",
        "serviceExtractionReadiness"
      ],
      "properties": {
        "noCrossVerticalImports": {
          "type": "boolean",
          "const": true
        },
        "allowedCrossingModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "api-only",
              "remote-contract-only",
              "shared-primitive-only"
            ]
          },
          "uniqueItems": true
        },
        "requiredBoundaryRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "auth",
              "session",
              "trace",
              "tenant",
              "locale",
              "fallback",
              "trust",
              "compatibility"
            ]
          },
          "uniqueItems": true
        },
        "remoteExtractionReadiness": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "stable-route-ownership",
              "loader-bridge-contract",
              "fallback-ui",
              "remote-trust-metadata",
              "compatibility-digest",
              "telemetry-hooks"
            ]
          },
          "uniqueItems": true
        },
        "serviceExtractionReadiness": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "api-contract",
              "auth-boundary",
              "session-boundary",
              "trace-boundary",
              "operation-context",
              "error-envelope-policy",
              "independent-scale-boundary"
            ]
          },
          "uniqueItems": true
        },
        "forbiddenImportPatterns": {
          "$ref": "#/$defs/stringList"
        },
        "requiredSnippetRefs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "gateInputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boundaryGuardProfile": {
          "type": "string",
          "minLength": 1
        },
        "moduleCertificationProfile": {
          "type": "string",
          "minLength": 1
        },
        "supportMatrixRefs": {
          "$ref": "#/$defs/stringList"
        },
        "incidentHooks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "event", "owners"],
            "properties": {
              "id": {
                "$ref": "#/$defs/targetId"
              },
              "event": {
                "type": "string",
                "enum": [
                  "remote-fallback",
                  "contract-regression",
                  "support-tier-change",
                  "incident-declared",
                  "rollout-paused"
                ]
              },
              "owners": {
                "$ref": "#/$defs/principalRefs"
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "riskTier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
