{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modernjs.dev/super-app-rfc-adr/contracts/mv-template-manifest.schema.json",
  "title": "Micro Vertical Template Manifest",
  "description": "Contract for materializing Micro Vertical starter templates from builtin, npm, git, or local sources with explicit supply-chain policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "template",
    "source",
    "integrity",
    "materialization",
    "lifecyclePolicy",
    "validation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "compatibilityLane"],
      "properties": {
        "id": {
          "$ref": "#/$defs/templateId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "compatibilityLane": {
          "type": "string",
          "enum": ["ultramodern-mv", "ultramodern-shell", "ultramodern-remote"]
        },
        "minimumModernVersion": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/builtinSource"
        },
        {
          "$ref": "#/$defs/npmSource"
        },
        {
          "$ref": "#/$defs/gitSource"
        },
        {
          "$ref": "#/$defs/localSource"
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksums", "provenance"],
      "properties": {
        "checksums": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/checksum"
          }
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "lockfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetRoot", "allowedPaths", "deniedPaths"],
      "properties": {
        "targetRoot": {
          "type": "string",
          "enum": ["generated-project-root", "workspace-package-root"]
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/materializationPath"
          }
        },
        "deniedPaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/materializationPath"
          },
          "allOf": [
            {
              "contains": {
                "const": ".git/**"
              }
            },
            {
              "contains": {
                "const": ".github/**"
              }
            },
            {
              "contains": {
                "const": ".npmrc"
              }
            },
            {
              "contains": {
                "const": ".yarnrc"
              }
            },
            {
              "contains": {
                "const": ".env"
              }
            },
            {
              "contains": {
                "const": ".env.*"
              }
            },
            {
              "contains": {
                "const": "node_modules/**"
              }
            },
            {
              "contains": {
                "const": "dist/**"
              }
            }
          ]
        },
        "overwritePolicy": {
          "type": "string",
          "enum": ["deny-existing", "allow-generated-only"],
          "default": "deny-existing"
        }
      }
    },
    "lifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denyByDefault", "deniedScripts", "allowedScripts"],
      "properties": {
        "denyByDefault": {
          "type": "boolean",
          "const": true
        },
        "deniedScripts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lifecycleScript"
          },
          "allOf": [
            {
              "contains": {
                "const": "preinstall"
              }
            },
            {
              "contains": {
                "const": "install"
              }
            },
            {
              "contains": {
                "const": "postinstall"
              }
            },
            {
              "contains": {
                "const": "prepare"
              }
            }
          ]
        },
        "allowedScripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycleScript"
          },
          "default": []
        },
        "requiresExplicitOptIn": {
          "type": "boolean",
          "const": true,
          "default": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValidation",
        "sourceValidation",
        "materializationValidation",
        "postMaterializationValidation"
      ],
      "properties": {
        "schemaValidation": {
          "type": "boolean",
          "const": true
        },
        "sourceValidation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "source-type-supported",
              "npm-version-exact",
              "git-ref-pinned",
              "checksum-verified",
              "provenance-present"
            ]
          }
        },
        "materializationValidation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "path-boundary-allowlist",
              "path-boundary-denylist",
              "no-path-traversal",
              "no-absolute-paths",
              "overwrite-policy-enforced"
            ]
          }
        },
        "postMaterializationValidation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ultramodern-contract-check",
              "dependency-install-with-lifecycle-deny",
              "lockfile-integrity-check",
              "template-manifest-retained"
            ]
          }
        },
        "expectedCommands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "templateId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "materializationPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:[\\\\/]"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      }
    },
    "lifecycleScript": {
      "type": "string",
      "enum": [
        "preinstall",
        "install",
        "postinstall",
        "prepare",
        "prepack",
        "postpack",
        "prepublish",
        "prepublishOnly",
        "postpublish",
        "prestart",
        "start",
        "poststart"
      ]
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "scope"],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "scope": {
          "type": "string",
          "enum": ["manifest", "source-archive", "source-tree", "lockfile"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "issuer", "subject"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["repo-local", "npm-provenance", "slsa", "manual-attestation"]
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "attestationUrl": {
          "type": "string",
          "format": "uri"
        },
        "buildSha": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "builtinSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "const": "builtin"
        },
        "name": {
          "$ref": "#/$defs/templateId"
        },
        "repositoryPath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "npmSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "packageName", "version", "tarballSha256"],
      "properties": {
        "type": {
          "type": "string",
          "const": "npm"
        },
        "packageName": {
          "type": "string",
          "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "registry": {
          "type": "string",
          "format": "uri"
        },
        "tarballSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "ref", "checkoutSha"],
      "properties": {
        "type": {
          "type": "string",
          "const": "git"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sha"],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "sha"
                },
                "sha": {
                  "$ref": "#/$defs/sha1"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "tag", "tagSha"],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "tag"
                },
                "tag": {
                  "type": "string",
                  "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
                },
                "tagSha": {
                  "$ref": "#/$defs/sha1"
                }
              }
            }
          ]
        },
        "checkoutSha": {
          "$ref": "#/$defs/sha1"
        },
        "subdirectory": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "localSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "const": "local"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "allowOutsideWorkspace": {
          "type": "boolean",
          "const": false,
          "default": false
        }
      }
    }
  }
}
