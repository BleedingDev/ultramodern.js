{
  "moduleId": "example-module",
  "version": "1.0.0",
  "runtime": "effect-first",
  "sourceDir": "tests/integration/module-sdk-fixtures/example-module",
  "lifecycleHooks": [
    "registerRoutes",
    "registerCapabilities",
    "registerMigrations"
  ],
  "policyHooks": [
    "authorize",
    "enforceTenantScope",
    "validateOperationContext"
  ],
  "observability": {
    "signals": ["metrics", "audit", "trace"],
    "hooks": ["emitBusinessMetric", "emitAuditEvent", "emitTraceContext"]
  },
  "compliance": {
    "usesSdkContracts": true,
    "usesPolicyMiddleware": true,
    "usesObservabilityHooks": true
  }
}
