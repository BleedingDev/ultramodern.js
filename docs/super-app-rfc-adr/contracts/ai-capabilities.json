{
  "schemaVersion": 1,
  "updatedAt": "2026-02-26T00:00:00.000Z",
  "capabilities": [
    {
      "id": "runtime.status.read",
      "description": "Read runtime status snapshot including telemetry and canary health.",
      "sideEffect": "read",
      "mcp": {
        "tool": "runtime.status.get",
        "version": "1",
        "inputSchema": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "tokenEnv": {
              "type": "string"
            },
            "headerName": {
              "type": "string"
            },
            "timeout": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "cli": {
        "command": "modern runtime status --json",
        "bin": "modern",
        "args": ["runtime", "status", "--json"],
        "argMap": {
          "endpoint": "--endpoint",
          "token": "--token",
          "tokenEnv": "--token-env",
          "headerName": "--header-name",
          "timeout": "--timeout"
        }
      }
    },
    {
      "id": "runtime.fallback.signal.write",
      "description": "Emit runtime fallback signal to mutate contract gate state for canary autopilot.",
      "sideEffect": "write",
      "mcp": {
        "tool": "runtime.fallback.signal.post",
        "version": "1",
        "inputSchema": {
          "type": "object",
          "required": ["appName"],
          "properties": {
            "appName": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "phase": {
              "type": "string"
            },
            "entry": {
              "type": "string"
            },
            "runtimeDigest": {
              "type": "string"
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            },
            "endpoint": {
              "type": "string"
            },
            "token": {
              "type": "string"
            },
            "tokenEnv": {
              "type": "string"
            },
            "headerName": {
              "type": "string"
            },
            "timeout": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "cli": {
        "command": "modern runtime fallback-signal --json",
        "bin": "modern",
        "args": ["runtime", "fallback-signal", "--json"],
        "argMap": {
          "appName": "--app",
          "reason": "--reason",
          "phase": "--phase",
          "entry": "--entry",
          "runtimeDigest": "--runtime-digest",
          "metadata": "--metadata",
          "endpoint": "--endpoint",
          "token": "--token",
          "tokenEnv": "--token-env",
          "headerName": "--header-name",
          "timeout": "--timeout"
        }
      }
    }
  ]
