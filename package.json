{
  "private": true,
  "name": "modern-js-monorepo",
  "description": "A Progressive React Framework for modern web development.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": "web-infra-dev/modern.js",
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "scripts": {
    "setup": "npm run reset && pnpm install",
    "reset": "npx rimraf --glob ./**/node_modules",
    "test:framework": "cd tests && pnpm run test:framework",
    "test:builder": "cd tests && pnpm run test:builder",
    "test:ut": "rstest",
    "test:ut:update": "rstest -u",
    "lint:package-json": "cd ./scripts/lint-package-json && pnpm start",
    "prepare-build": "cross-env NX_DAEMON=false NX_REJECT_UNKNOWN_LOCAL_CACHE=0 nx run-many -t build -p @modern-js/* --exclude=@modern-js/main-doc,@modern-js/module-tools-docs --maxParallel=4",
    "prepare": "npm run prepare-build && husky",
    "prepare-build-continue": "cross-env NX_DAEMON=false NX_REJECT_UNKNOWN_LOCAL_CACHE=0 nx run-many -t build -p @modern-js/* --exclude=@modern-js/main-doc,@modern-js/module-tools-docs --nxBail=false --maxParallel=4 || echo 'Build completed with some failures, continuing...'",
    "build:required": "cross-env NX_DAEMON=false nx run-many -t build -p @modern-js/app-tools @modern-js/builder @modern-js/bff-core @modern-js/plugin-bff @modern-js/runtime @modern-js/utils",
    "lint": "biome check",
    "change": "changeset add",
    "bump": "changeset version",
    "pre:enter": "changeset pre enter",
    "pre:exit": "changeset pre exit",
    "change-status": "changeset status",
    "gen-release-note": "cd ./scripts/release-note && pnpm start",
    "get-release-version": "cd ./scripts/release-version && pnpm start",
    "release": "pnpm publish --filter ./packages/** --report-summary --ignore-scripts",
    "fix:lockfile": "pnpm install --fix-lockfile",
    "update:lockfile": "pnpm install --lockfile-only",
    "check-changeset": "cd ./scripts/check-changeset && pnpm start",
    "check-dependencies": "node ./scripts/check-dependencies.js",
    "update-codesmith": "cd ./scripts/update-codesmith && pnpm start",
    "update-rspress": "npx taze major --include /rspress/ -w -r -l",
    "update-rsbuild": "npx taze major --include /rsbuild/ -w -r -l",
    "update-nx-cache": "cross-env NX_DAEMON=false nx reset && npm run prepare-build",
    "gen:docs": "rm -rf doc_output && mkdir doc_output && cp -r ./packages/document/doc_build/* ./doc_output",
    "docs:v2-link": "echo '/v2/*  https://modernjs-v2.netlify.app/:splat  200' >> doc_output/_redirects",
    "build:docs": "pnpm --filter @modern-js/main-doc... build && npm run gen:docs && npm run docs:v2-link",
    "prebuild:main-doc-docs": "cross-env NX_DAEMON=false nx run @modern-js/main-doc:build",
    "validate:main-doc-docs": "pnpm run prebuild:main-doc-docs && pnpm --filter @modern-js/main-doc run build:doc",
    "validate:module-sdk-contracts": "node scripts/module-sdk-contracts/validate-module-sdk-contracts.js --contract docs/super-app-rfc-adr/contracts/module-sdk-contracts.json --skip-manifest-validation",
    "validate:boundary-guards": "node scripts/boundary-guards/check-boundary-violations.js --profile scripts/boundary-guards/profile.json",
    "validate:module-certification-gates": "node scripts/release-gates/validate-release-candidate-gates.js --profile scripts/release-gates/module-certification-profile.json --evidence-dir docs/super-app-rfc-adr/evidence/module-certification/current",
    "validate:wave0-mv-contracts": "node scripts/wave0-mv-contracts/validate-wave0-mv-contracts.js",
    "validate:mv-lane-policy": "node scripts/mv-lane-policy/validate-lane-policy.js",
    "validate:mv-ci-hardening": "node scripts/mv-ci-hardening/validate-ci-hardening.js",
    "validate:gate-snapshot": "node scripts/release-gates/validate-gate-snapshot.js --snapshot-path .modern/contract-gates.json",
    "validate:mcp-cli-parity": "node scripts/ai-capabilities/validate-mcp-cli-parity.js --contract docs/super-app-rfc-adr/contracts/ai-capabilities.json --out .modern/mcp-cli-parity.json",
    "generate:mcp-adapter": "node scripts/ai-capabilities/generate-mcp-adapter.js --contract docs/super-app-rfc-adr/contracts/ai-capabilities.json --out .modern/mcp/adapter-manifest.json --mcporter-out .modern/mcporter.json",
    "serve:mcp-cli-bridge": "node scripts/ai-capabilities/mcp-cli-bridge.js --contract docs/super-app-rfc-adr/contracts/ai-capabilities.json",
    "benchmark:runtime-resilience": "node benchmark/runtime-resilience/run.js",
    "benchmark:runtime-resilience:worker-lane-gate": "node benchmark/runtime-resilience/run.js --mode worker-lane-only --worker-lane-enabled --fail-on-worker-lane-gate",
    "load:superapp-erp": "node scripts/superapp-load/run-superapp-load.js",
    "validate:superapp-erp-effect-load": "node scripts/superapp-load/run-superapp-load.js",
    "validate:bun-smoke": "bun scripts/module-sdk-contracts/validate-module-sdk-contracts.js --contract docs/super-app-rfc-adr/contracts/module-sdk-contracts.json --manifest docs/super-app-rfc-adr/contracts/module-manifest.example.json && bun scripts/boundary-guards/check-boundary-violations.js --profile scripts/boundary-guards/profile.json && bun scripts/release-gates/validate-release-candidate-gates.js --profile scripts/release-gates/module-certification-profile.json --evidence-dir docs/super-app-rfc-adr/evidence/module-certification/current --skip-commands && bun scripts/release-gates/validate-release-candidate-gates.js --profile scripts/release-gates/rc-contract-profile.json --evidence-dir docs/super-app-rfc-adr/evidence/release-candidate/current --skip-commands",
    "validate:rc-gates": "node scripts/release-gates/validate-release-candidate-gates.js --profile scripts/release-gates/rc-contract-profile.json --evidence-dir docs/super-app-rfc-adr/evidence/release-candidate/current",
    "test:all:parallel": "node scripts/test-orchestrator/run-parallel-tests.js",
    "test:all:parallel:analyze": "node scripts/test-orchestrator/run-parallel-tests.js --mode analyze"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --files-ignore-unknown=true"
    ],
    "**/package.json": [
      "pnpm check-dependencies"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@biomejs/biome": "2.4.13",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@modern-js/tsconfig": "workspace:*",
    "@rstest/core": "0.9.9",
    "@scripts/build": "workspace:*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "check-dependency-version-consistency": "6.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "~16.4.0",
    "nx": "^22.7.1",
    "rimraf": "^6.1.3"
  },
  "pnpm": {
    "overrides": {
      "micromatch": "^4.0.8",
      "read-yaml-file>js-yaml": "3.14.2",
      "@remix-run/router": ">=1.23.2",
      "h3": ">=1.15.11",
      "tar": ">=7.5.13",
      "diff": ">=4.0.4",
      "debug": ">=4.4.3",
      "cross-spawn": ">=6.0.6",
      "lodash-es": ">=4.18.1",
      "esbuild": ">=0.25.0",
      "tmp": ">=0.2.5",
      "@isaacs/brace-expansion": ">=5.0.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react-side-effect@2.1.2>react": "19"
      }
    },
    "allowedDeprecatedVersions": {
      "@babel/plugin-proposal-object-rest-spread": "7.12.1 || 7.20.7",
      "@babel/plugin-proposal-private-property-in-object": "7.21.0",
      "@financial-times/polyfill-useragent-normaliser": "1.10.2",
      "formidable": "1.2.6",
      "sourcemap-codec": "1.4.8",
      "js-polyfills": "0.1.43",
      "picturefill": "3.0.3",
      "querystring": "0.2.0",
      "string-similarity": "4.0.4",
      "source-map-resolve": "0.6.0 || 0.5.3",
      "@formatjs/intl-utils": "3.8.4",
      "debug": "4.1.1",
      "uuid": "3.4.0",
      "trim": "0.0.1"
    }
  }
}
