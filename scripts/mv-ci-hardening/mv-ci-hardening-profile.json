{
  "schemaVersion": 1,
  "name": "mv-ci-tier-budgets-and-flake-policy",
  "validationDate": "2026-04-28",
  "policy": {
    "maxFlakeWaiverDays": 14,
    "maxRetryAttempts": 2
  },
  "tiers": {
    "golden": {
      "maxRuntimeMinutes": 45,
      "maxTimeoutMinutes": 45,
      "maxFlakeWaivers": 0,
      "requiredEvidence": "full contract, failure, rollback, and certification evidence"
    },
    "compat": {
      "maxRuntimeMinutes": 30,
      "maxTimeoutMinutes": 30,
      "maxFlakeWaivers": 1,
      "requiredEvidence": "compatibility and regression evidence"
    },
    "experimental": {
      "maxRuntimeMinutes": 12,
      "maxTimeoutMinutes": 12,
      "maxFlakeWaivers": 1,
      "requiredEvidence": "opt-in smoke evidence only"
    }
  },
  "checks": [
    {
      "id": "mv-golden-contract-certification",
      "tier": "golden",
      "owner": "super-app-platform",
      "riskClass": "production-default",
      "runtimeBudgetMinutes": 40,
      "timeoutMinutes": 45,
      "command": "node --test scripts/mv-integration-pilot/__tests__/*.test.js scripts/mv-production-rollout/__tests__/*.test.js",
      "retryPolicy": {
        "maxAttempts": 1
      }
    },
    {
      "id": "mv-compat-runtime-regression",
      "tier": "compat",
      "owner": "compatibility-platform",
      "riskClass": "supported-compatibility",
      "runtimeBudgetMinutes": 24,
      "timeoutMinutes": 30,
      "command": "node --test scripts/mv-integration-pilot/__tests__/remote-failure-drills.test.js scripts/mv-integration-pilot/__tests__/rollback-kill-switch-drill.test.js",
      "retryPolicy": {
        "maxAttempts": 1
      }
    },
    {
      "id": "mv-experimental-smoke",
      "tier": "experimental",
      "owner": "experimentation-platform",
      "riskClass": "opt-in",
      "runtimeBudgetMinutes": 8,
      "timeoutMinutes": 10,
      "command": "node --test scripts/mv-integration-pilot/__tests__/reference-topology.test.js",
      "retryPolicy": {
        "maxAttempts": 1
      }
    }
  ]
}
