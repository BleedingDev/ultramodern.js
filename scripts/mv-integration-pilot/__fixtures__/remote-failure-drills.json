{
  "schemaVersion": 1,
  "id": "wave2-remote-failure-drills",
  "description": "Remote timeout, network failure, and integrity mismatch drills for the Wave 2 reference topology.",
  "passCases": [
    {
      "id": "uw2-02-timeout-remote-commerce",
      "title": "Commerce remote manifest timeout falls back to LKG shell surface",
      "failureMode": "remote-timeout",
      "environment": "staging",
      "affectedRemoteId": "remote-commerce",
      "expectedFallbackComponentId": "shell-super-app",
      "expectedFallback": {
        "reason": "timeout",
        "code": "MV_TIMEOUT",
        "phase": "load"
      },
      "expectations": {
        "shellSurvives": true,
        "fallbackTelemetryPresent": true,
        "affectedRemoteIsolated": true,
        "unaffectedComponentIds": [
          "shell-super-app",
          "remote-identity",
          "remote-design-system",
          "service-recommendations-effect"
        ]
      },
      "telemetry": {
        "eventName": "mv.remote.fallback",
        "fallback": {
          "reason": "timeout",
          "code": "MV_TIMEOUT",
          "phase": "load"
        },
        "evidenceRef": "evidence/wave2/remote-failure/uw2-02-timeout-remote-commerce.jsonl"
      },
      "remediation": {
        "ownerTeam": "commerce-experience",
        "runbookRef": "runbooks/wave2/remote-commerce.md#manifest-timeout",
        "evidenceRef": "evidence/wave2/remote-failure/uw2-02-timeout-remote-commerce.md"
      }
    },
