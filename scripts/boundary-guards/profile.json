{
  "schemaVersion": 1,
  "contractPath": "docs/super-app-rfc-adr/contracts/module-sdk-contracts.json",
  "moduleManifests": [
    "docs/super-app-rfc-adr/contracts/module-manifest.example.json"
  ],
  "importGuards": [
    {
      "id": "core-no-domain-or-vendor-connector-imports",
      "roots": [
        "packages/builder",
        "packages/runtime",
        "packages/server",
        "packages/toolkit",
        "packages/cli"
      ],
      "bannedImportPatterns": [
        "^@modules/[^/]+(/|$)",
        "/modules/[^/]+(/|$)",
        "^@integrations/[^/]+(/|$)"
      ]
    }
  ],
  "requiredSnippets": [
    {
      "id": "mf-runtime-trust-before-registration",
      "path": "packages/runtime/plugin-garfish/src/runtime/plugin.tsx",
      "includes": [
        "enforceRemoteTrustPolicy",
        "validateRuntimeCompatibility",
        "GarfishInstance.registerApp",
        "emitErrorFallbackTelemetry"
      ],
      "orderedIncludes": [
        "await enforceRemoteTrustPolicy",
        "validateRuntimeCompatibility(apps, {",
        "GarfishInstance.registerApp"
      ]
    },
    {
      "id": "mf-fallback-telemetry-load-unmount",
      "path": "packages/runtime/plugin-garfish/src/runtime/utils/apps.tsx",
      "includes": [
        "emitFallbackTelemetry",
        "reason: 'entry_load_failed'",
        "reason: 'lifecycle_failed'"
      ]
    },
    {
      "id": "cross-project-operation-context-node",
      "path": "packages/server/create-request/src/node.ts",
      "includes": [
        "x-modernjs-bff-operation-context",
        "traceparent",
        "traceId",
        "spanId"
      ]
    },
    {
      "id": "cross-project-operation-context-browser",
      "path": "packages/server/create-request/src/browser.ts",
      "includes": [
        "x-modernjs-bff-operation-context",
        "traceparent",
        "traceId",
        "spanId"
      ]
    },
    {
      "id": "cross-project-policy-enforcement",
      "path": "packages/server/bff-core/src/security/crossProjectPolicy.ts",
      "includes": [
        "evaluateCrossProjectPolicy",
        "missing_operation_context",
        "operation_context_mismatch"
      ]
    }
  ],
  "scanExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
}
