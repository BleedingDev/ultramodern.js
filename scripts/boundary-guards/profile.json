{
  "schemaVersion": 1,
  "importGuards": [
    {
      "id": "core-no-domain-or-vendor-connector-imports",
      "roots": [
        "packages/runtime",
        "packages/server",
        "packages/toolkit",
        "packages/cli"
      ],
      "bannedImportPatterns": [
        "^@modules/[^/]+(/|$)",
        "/modules/[^/]+(/|$)",
        "^@integrations/[^/]+(/|$)"
      ]
    }
  ],
  "scanExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
}
