{
  "additive": {
    "zone": "external",
    "old": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders",
          "response": { "items": "Order[]" }
        }
      ]
    },
    "new": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders",
          "response": { "items": "Order[]" }
        },
        {
          "method": "POST",
          "path": "/orders",
          "params": [{ "name": "body", "in": "body" }],
          "response": { "id": "string" }
        }
      ]
    },
    "expect": { "classification": "additive", "verdict": "pass" }
  },
  "breakingInternal": {
    "zone": "coordinated",
    "old": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string", "total": "number" }
        }
      ]
    },
    "new": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string" }
        }
      ]
    },
    "expect": { "classification": "breaking", "verdict": "pass-with-note" }
  },
  "breakingExternalNoMajor": {
    "zone": "external",
    "old": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string", "total": "number" }
        }
      ]
    },
    "new": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string" }
        }
      ]
    },
    "expect": { "classification": "breaking", "verdict": "fail" }
  },
  "breakingExternalWithMajor": {
    "zone": "external",
    "old": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string", "total": "number" }
        }
      ]
    },
    "new": {
      "kind": "rest",
      "surfaceId": "orders",
      "routes": [
        {
          "method": "GET",
          "path": "/orders/:id",
          "response": { "id": "string", "total": "number" }
        },
        {
          "method": "GET",
          "path": "/v2/orders/:id",
          "response": { "id": "string" },
          "major": 2
        }
      ]
    },
    "expect": {
      "classification": "additive",
      "verdict": "pass-with-note",
      "sideBySide": true
    }
  }
}
