{
  "additive": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-a" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [
        { "path": "./cart", "signature": "sig-cart-a" },
        { "path": "./wishlist", "signature": "sig-wishlist-a" }
      ]
    },
    "expect": { "classification": "additive", "verdict": "pass" }
  },
  "breakingInternal": {
    "zone": "coordinated",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-a" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-b" }]
    },
    "expect": { "classification": "breaking", "verdict": "pass-with-note" }
  },
  "breakingExternalNoMajor": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-a" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-b" }]
    },
    "expect": { "classification": "breaking", "verdict": "fail" }
  },
  "breakingExternalWithMajor": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-a" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [
        { "path": "./cart", "signature": "sig-cart-a" },
        { "path": "./cart/v2", "signature": "sig-cart-b", "major": 2 }
      ]
    },
    "expect": {
      "classification": "additive",
      "verdict": "pass-with-note",
      "sideBySide": true
    }
  },
  "breakingExternalMutateOldWithMajor": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart", "signature": "sig-cart-a" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [
        { "path": "./cart", "signature": "sig-cart-b" },
        { "path": "./cart/v2", "signature": "sig-cart-c", "major": 2 }
      ]
    },
    "expect": {
      "classification": "breaking",
      "verdict": "fail",
      "sideBySide": false
    }
  },
  "unverifiableInPlaceNoSignature": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart" }]
    },
    "expect": { "classification": "additive", "verdict": "pass" }
  },
  "unverifiableRemovalStillBreaking": {
    "zone": "external",
    "old": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": [{ "path": "./cart" }]
    },
    "new": {
      "kind": "mf",
      "surfaceId": "checkout",
      "exposes": []
    },
    "expect": { "classification": "breaking", "verdict": "fail" }
  }
}
