{
  "schemaVersion": 1,
  "name": "module-onboarding-certification-gates",
  "evidence": {
    "defaultDir": "docs/super-app-rfc-adr/evidence/module-certification/current",
    "requiredFiles": [
      "architecture-evidence.md",
      "validation-evidence.md",
      "test-evidence.md",
      "review-evidence.md"
    ],
    "requiredMetadataFields": [
      "author",
      "timestamp",
      "ticket_id",
      "commit_sha",
      "workflow_run_url",
      "module_id",
      "runtime_lane"
    ],
    "minimumReviewers": 2
  },
  "gateCommands": [
    {
      "command": "pnpm",
      "args": ["run", "validate:boundary-guards"]
    },
    {
      "command": "node",
      "args": ["--test", "scripts/boundary-guards/__tests__/validator.test.js"]
    }
  ]
}
