{
  "schemaVersion": 1,
  "name": "release-candidate-contract-gates",
  "evidence": {
    "defaultDir": "docs/super-app-rfc-adr/evidence/release-candidate/current",
    "requiredFiles": [
      "architecture-evidence.md",
      "validation-evidence.md",
      "test-evidence.md",
      "review-evidence.md"
    ],
    "requiredMetadataFields": [
      "author",
      "timestamp",
      "ticket_id",
      "commit_sha",
      "workflow_run_url"
    ],
    "minimumReviewers": 2
  },
  "gateCommands": [
    {
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/cli/builder",
        "exec",
        "rstest",
        "run",
        "tests/rsdoctor.test.ts",
        "--passWithNoTests"
      ]
    },
    {
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/cli/plugin-bff",
        "exec",
        "rstest",
        "run",
        "tests/regression.test.ts",
        "--passWithNoTests"
      ]
    },
    {
      "command": "pnpm",
      "args": ["--filter", "@modern-js/create-request", "test"]
    },
    {
      "command": "pnpm",
      "args": ["--filter", "@modern-js/bff-core", "test"]
    },
    {
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/solutions/app-tools",
        "exec",
        "rstest",
        "run",
        "tests/index.test.ts",
        "tests/presetUltramodern.test.ts",
        "--passWithNoTests"
      ]
    },
    {
      "command": "pnpm",
      "args": [
        "--filter",
        "@modern-js/runtime",
        "test",
        "--",
        "tests/ssr/serverRender/renderToString/entry.test.ts",
        "tests/ssr/serverRender/renderToStream/buildTemplate.after.test.ts"
      ]
    },
    {
      "command": "pnpm",
      "args": [
        "--filter",
        "@modern-js/prod-server",
        "test",
        "--",
        "applyPlugins.test.ts"
      ]
    },
    {
      "command": "pnpm",
      "args": [
        "--filter",
        "@modern-js/server-runtime-extensions",
        "test",
        "--",
        "telemetry.test.ts",
        "telemetryCanaryOrchestrator.test.ts",
        "telemetryAutopilot.test.ts",
        "contractGateAutopilot.test.ts"
      ]
    },
    {
      "command": "pnpm",
      "args": ["--dir", "tests", "run", "test:superapp-contracts"]
    }
  ]
}
