{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": {
    "enabled": true,
    "defaultBranch": "main",
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "includes": [
      "**",
      "!**/package.json",
      "!**/packages/document/main-doc/scripts/summary.*.json",
      "!**/packages/runtime/plugin-runtime/tests/document/feature/document/_tempTsconfig.json",
      "!**/tests/integration/swc/fixtures/minify-css/src/bootstrap.css",
      "!**/tests/integration/swc/fixtures/config-function/src/bootstrap.css",
      "!**/packages/runtime/plugin-runtime/static/**",
      "!**/tests/integration/i18n/mf-consumer/@mf-types/**"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "double",
      "lineWidth": 80
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "noUnusedTemplateLiteral": "off",
        "noUselessElse": "off",
        "useNumberNamespace": "off",
        "useImportType": "off",
        "noParameterAssign": "off",
        "useTemplate": "off",
        "useDefaultParameterLast": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off",
        "noImplicitAnyLet": "off",
        "noAssignInExpressions": "off",
        "noPrototypeBuiltins": "off",
        "noRedeclare": "off",
        "noDuplicateFontNames": "off",
        "noShorthandPropertyOverrides": "off",
        "noDuplicateAtImportRules": "off",
        "useIterableCallbackReturn": "off",
        "noDuplicateProperties": "off",
        "noNonNullAssertedOptionalChain": "off",
        "noControlCharactersInRegex": "off",
        "noExportsInTest": "off",
        "noTsIgnore": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useArrowFunction": "off",
        "useFlatMap": "off",
        "noBannedTypes": "off",
        "noUselessContinue": "off",
        "noUselessFragments": "off",
        "useOptionalChain": "off",
        "noImportantStyles": "off",
        "noArguments": "off",
        "useIndexOf": "off",
        "useDateNow": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useAltText": "off",
        "useHtmlLang": "off",
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "useIframeTitle": "off",
        "noStaticElementInteractions": "off"
      },
      "performance": {
        "noDelete": "off",
        "noAccumulatingSpread": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off",
        "noBlankTarget": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnreachable": "off",
        "noInvalidUseBeforeDeclaration": "off",
        "noUnknownProperty": "off",
        "noUnusedVariables": "off",
        "noUnusedImports": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "off",
        "useHookAtTopLevel": "off",
        "noEmptyPattern": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "tests/integration/tailwindcss/fixtures/tailwindcss-v2/src/**/*.css",
        "tests/integration/tailwindcss/fixtures/tailwindcss-v3/src/**/*.css"
      ],
      "linter": {
        "rules": { "suspicious": { "noUnknownAtRules": "off" } }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.beads/**/*",
      "!**/.vscode/**/*",
      "!**/.nx/**/*",
      "!**/coverage/**/*",
      "!**/node_modules/**/*",
      "!**/dist/**/*",
      "!packages/sidecar/*/bin",
      "!**/dist-1/**/*",
      "!**/dist-2/**/*",
      "!**/dist-swc/**/*",
      "!**/output/**/*",
      "!**/.output/**/*",
      "!**/.netlify/**/*",
      "!**/lib/**/*",
      "!**/compiled/**/*",
      "!**/.rpt2_cache/**/*",
      "!**/packages/runtime/plugin-runtime/tests/document/feature/document/_main.html.js",
      "!**/packages/server/core/tests/fixtures/mock/cjs/config/mock/**/*",
      "!**/packages/server/server/tests/fixtures/mock/cjs/config/mock/**/*",
      "!**/tests/integration/ssr/fixtures/preload/**/*",
      "!**/tests/e2e/builder/cases/html/template/static/**/*.html",
      "!**/tests/e2e/builder/cases/**/dist-tools-*",
      "!**/tests/integration/swc/fixtures/transform-fail/src/App.jsx",
      "!**/tests/integration/module/plugins/vue/**/*",
      "!**/packages/module/plugin-module-node-polyfill/src/globals.js",
      "!**/packages/runtime/plugin-runtime/static",
      "!**/packages/cli/flight-server-transform-plugin/tests/fixture/**/*",
      "!**/@mf-types",
      "!**/packages/toolkit/create/template/**/*",
      "!**/packages/toolkit/sandpack-react/scripts/mwa-template/**/*",
      "!**/tests/skill/fixtures/**/*"
    ]
  }
}
